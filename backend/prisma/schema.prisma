generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectSource {
  ZIP_UPLOAD
  GITHUB
}

enum ProjectStatus {
  UPLOADING
  IMPORTING
  READY
  ANALYZING
  FAILED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  source      ProjectSource
  status      ProjectStatus @default(UPLOADING)

  repositoryUrl String?
  branch        String?
  rootPath      String?

  fileCount Int     @default(0)
  language  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
