generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectSource {
  ZIP_UPLOAD
  GITHUB
}

enum ProjectStatus {
  UPLOADING
  IMPORTING
  READY
  ANALYZING
  FAILED
}

enum RepositoryFileType {
  FILE
  DIRECTORY
}

enum DependencyKind {
  IMPORT
  EXPORT
  REQUIRE
  DYNAMIC_IMPORT
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  source      ProjectSource
  status      ProjectStatus @default(UPLOADING)

  repositoryUrl String?
  branch        String?
  rootPath      String?

  fileCount Int     @default(0)
  language  String?

  files        RepositoryFile[]
  dependencies RepositoryDependency[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model RepositoryFile {
  id        String @id @default(cuid())
  projectId String

  name String
  path String

  type RepositoryFileType

  extension String?
  language  String?

  size       BigInt    @default(0)
  modifiedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  outgoingDependencies RepositoryDependency[] @relation("DependencySource")

  incomingDependencies RepositoryDependency[] @relation("DependencyTarget")

  createdAt DateTime @default(now())

  @@unique([projectId, path])
  @@index([projectId])
  @@index([projectId, type])
  @@index([projectId, language])
}

model RepositoryDependency {
  id           String  @id @default(cuid())
  projectId    String
  sourceFileId String
  targetFileId String?

  specifier   String
  kind        DependencyKind
  isExternal  Boolean        @default(false)
  packageName String?
  line        Int

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sourceFile RepositoryFile @relation("DependencySource", fields: [sourceFileId], references: [id], onDelete: Cascade)

  targetFile RepositoryFile? @relation("DependencyTarget", fields: [targetFileId], references: [id], onDelete: SetNull)

  @@unique([projectId, sourceFileId, specifier, kind, line])
  @@index([projectId])
  @@index([sourceFileId])
  @@index([targetFileId])
  @@index([projectId, isExternal])
}
